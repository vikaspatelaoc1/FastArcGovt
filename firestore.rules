rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /jobs/{jobId} {
      allow read, write: if true;
    }

    match /site_config/{configId} {
      allow read, write: if true;
    }

    match /employees/{employeeId} {
      allow read, write: if true;
    }

    match /subscribers/{subscriberId} {
      allow read, write: if true;
    }
  }
}
