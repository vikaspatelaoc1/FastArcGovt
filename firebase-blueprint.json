{
  "entities": {
    "Job": {
      "title": "Job",
      "description": "Government job alerts and notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "state": { "type": "string" },
        "postDate": { "type": "string" }
      },
      "required": ["id", "title", "category"]
    },
    "Subscriber": {
      "title": "Subscriber",
      "description": "User who subscribed for job alert notifications",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "category": { "type": "string" },
        "notes": { "type": "string" },
        "date": { "type": "string" },
        "createdAt": { "type": "string" },
        "source": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Employee": {
      "title": "Employee",
      "description": "Portal staff member account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "username": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "username"]
    },
    "StagingJob": {
      "title": "StagingJob",
      "description": "Staging queue job for backend validation before live publication",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "title"]
    }
  },
  "firestore": {
    "/jobs/{jobId}": {
      "schema": "Job",
      "description": "Active published govt jobs"
    },
    "/subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Active public newsletter and job alert subscribers"
    },
    "/deleted_subscribers/{subscriberId}": {
      "schema": "Subscriber",
      "description": "Recycle bin of deleted subscribers"
    },
    "/employees/{employeeId}": {
      "schema": "Employee",
      "description": "Registered employee and staff records"
    },
    "/staging_jobs/{jobId}": {
      "schema": "StagingJob",
      "description": "Staged jobs pending review or sync"
    }
  }
}
